# 部署配置——复制为 .env 并填入真实值（.env 已 gitignore）
# main.py 启动时自动加载本文件

# 海康 Artemis 平台
HIK_BASE_URL=https://223.71.143.153:14443
HIK_APP_KEY=在此填入AppKey
HIK_APP_SECRET=在此填入AppSecret

# minio 图片存储
MINIO_ENDPOINT=192.166.250.223:17077
MINIO_AK=minio
MINIO_SK=在此填入minio密码

# 业务平台上报接口
REPORT_URL=http://192.166.250.224:17082/api/insert_ai_result
# minio 外网地址（必须带端口，整体替换内网 host:port）
EXTERNAL_HOST=223.108.117.18:17077

# 推理服务（水面分割 + 漂浮物 YOLO），不配置则用本机默认
INFER_ENDPOINT=http://127.0.0.1:8005/infer

# 摄像头自动接入（可选）：业务平台摄像头清单接口。
# 填入后启动时自动为未标定摄像头建档（抓一帧当参照帧 + 排口点用水面质心兜底）；
# 留空 = 只监测 config/cameras 里已标定的摄像头
CAMERA_LIST_URL=http://192.166.250.224:17082/api/jyly/cameraindexcode
# 自动建档的摄像头默认开启的漂浮物引擎（留空 = 不开漂浮物检测）
FLOAT_ENGINE_ID=floating/20261030_145216

# VLM 多模态大模型终判（留空 VLM_BASE_URL = 关闭 VLM，系统退化为规则+状态机）
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=
# 公司网关包装格式（响应 {code,data:{choices}}）填 true；标准 OpenAI 格式填 false
VLM_ENVELOPE=true
